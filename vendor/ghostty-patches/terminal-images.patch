+/// Advance image animations using an embedder-provided monotonic millisecond clock.
+pub fn tick(terminal_: terminal_c.Terminal, now_ms: u64, out_changed: ?*bool) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const output = out_changed orelse return .invalid_value;
+    const t = wrapper.terminal;
+    const animation = @import("../kitty/graphics_animation.zig");
+    const primary = if (t.screens.get(.primary)) |screen| animation.tick(t.io(), t.gpa(), &screen.kitty_images, now_ms) else false;
+    const alternate = if (t.screens.get(.alternate)) |screen| animation.tick(t.io(), t.gpa(), &screen.kitty_images, now_ms) else false;
+    output.* = primary or alternate;
+    return .success;
+}
+
+pub const VirtualPlacementCallback = *const fn (?*anyopaque, u32, *const PlacementRenderInfo, u32, u32) callconv(lib.calling_conv) void;
+
+/// Visit resolved Unicode placeholder fragments in the active viewport.
+/// Borrowed callback values are valid only until the callback returns.
+pub fn visit_virtual(terminal_: terminal_c.Terminal, userdata: ?*anyopaque, callback: ?VirtualPlacementCallback) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const visit = callback orelse return .invalid_value;
+    const t = wrapper.terminal;
+    const storage = &t.screens.active.kitty_images;
+    const top = t.screens.active.pages.getTopLeft(.viewport);
+    const bot = t.screens.active.pages.getBottomRight(.viewport) orelse return .success;
+    const cell_w = @max(1, t.width_px / t.cols);
+    const cell_h = @max(1, t.height_px / t.rows);
+    var iter = @import("../kitty/graphics_unicode.zig").placementIterator(top, bot);
+    while (iter.next()) |p| {
+        const img = storage.imageById(p.image_id) orelse continue;
+        const rp = p.renderPlacement(storage, &img, cell_w, cell_h) catch continue;
+        if (rp.dest_width == 0 or rp.dest_height == 0) continue;
+        const position = t.screens.active.pages.pointFromPin(.viewport, rp.top_left) orelse continue;
+        const info: PlacementRenderInfo = .{
+            .pixel_width = rp.dest_width,
+            .pixel_height = rp.dest_height,
+            .viewport_col = @intCast(rp.top_left.x),
+            .viewport_row = @intCast(position.viewport.y),
+            .viewport_visible = true,
+            .source_x = rp.source_x,
+            .source_y = rp.source_y,
+            .source_width = rp.source_width,
+            .source_height = rp.source_height,
+        };
+        visit(userdata, p.image_id, &info, rp.offset_x, rp.offset_y);
+    }
+    return .success;
+}
