+//! Kitty animation canvases and playback, owned by terminal image storage.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const Terminal = @import("../Terminal.zig");
+const command = @import("graphics_command.zig");
+const image = @import("graphics_image.zig");
+const Storage = @import("graphics_storage.zig").ImageStorage;
+
+fn find(storage: *Storage, id: u32, number: u32) !*image.Image {
+    if ((id == 0 and number == 0) or (id != 0 and number != 0)) return error.InvalidData;
+    const resolved = if (id != 0) id else (storage.imageByNumber(number) orelse return error.ImageNotFound).id;
+    return storage.images.getPtr(resolved) orelse error.ImageNotFound;
+}
+
+fn prepare(alloc: Allocator, storage: *Storage, img: *image.Image) !void {
+    const previous = img.byteSize();
+    const rgba_size = @as(usize, img.width) * img.height * 4;
+    if (img.frames.items.len == 0 and rgba_size > storage.total_limit -| (storage.total_bytes - previous)) return error.StorageFull;
+    try img.ensureFrames(alloc);
+    storage.total_bytes = storage.total_bytes - previous + img.byteSize();
+}
+
+fn changed(io: std.Io, storage: *Storage, img: *image.Image) void {
+    storage.markMutated(io);
+    img.generation = storage.generation;
+}
+
+fn frameIndex(img: *const image.Image, number: u32) !usize {
+    if (number == 0 or number > img.frames.items.len) return error.ImageNotFound;
+    return number - 1;
+}
+
+fn checkRect(width: u32, height: u32, x: u32, y: u32, w: u32, h: u32) !void {
+    if (x > width or y > height or w == 0 or h == 0 or w > width - x or h > height - y) return error.InvalidData;
+}
+
+fn composePixels(dest: []u8, source: []const u8, dest_width: u32, source_width: u32, dx: u32, dy: u32, sx: u32, sy: u32, width: u32, height: u32, overwrite: bool, source_stride: usize) void {
+    for (0..height) |row| {
+        for (0..width) |col| {
+            const d = ((@as(usize, dy) + row) * dest_width + dx + col) * 4;
+            const s = ((@as(usize, sy) + row) * source_width + sx + col) * source_stride;
+            const alpha: u32 = if (source_stride == 4) source[s + 3] else 255;
+            if (overwrite or alpha == 255) {
+                @memcpy(dest[d..][0..3], source[s..][0..3]);
+                dest[d + 3] = @intCast(alpha);
+            } else if (alpha != 0) {
+                const old_alpha: u32 = dest[d + 3];
+                const combined = alpha * 255 + old_alpha * (255 - alpha);
+                for (0..3) |component| {
+                    const numerator = @as(u32, source[s + component]) * alpha * 255 + @as(u32, dest[d + component]) * old_alpha * (255 - alpha);
+                    dest[d + component] = @intCast((numerator + combined / 2) / combined);
+                }
+                dest[d + 3] = @intCast((combined + 127) / 255);
+            }
+        }
+    }
+}
+
+pub fn transmit(io: std.Io, alloc: Allocator, terminal: *Terminal, cmd: *const command.Command) !command.Response {
+    const storage = &terminal.screens.active.kitty_images;
+    const transmission = cmd.transmission().?;
+    var loading: image.LoadingImage = if (storage.loading) |pending| blk: {
+        if (pending.animation_frame == null) return error.InvalidData;
+        pending.addData(alloc, cmd.data) catch |err| {
+            pending.destroy(alloc);
+            storage.loading = null;
+            return err;
+        };
+        if (transmission.more_chunks) return .{};
+        defer alloc.destroy(pending);
+        storage.loading = null;
+        break :blk pending.*;
+    } else blk: {
+        _ = try find(storage, transmission.image_id, transmission.image_number);
+        break :blk try image.LoadingImage.init(io, alloc, cmd, storage.image_limits);
+    };
+    var loading_owned = true;
+    errdefer if (loading_owned) loading.deinit(alloc);
+    if (transmission.more_chunks) {
+        const pending = try alloc.create(image.LoadingImage);
+        pending.* = loading;
+        storage.loading = pending;
+        return .{};
+    }
+    const settings = loading.animation_frame.?;
+    var patch = try loading.complete(alloc);
+    defer patch.deinit(alloc);
+    loading.deinit(alloc);
+    loading_owned = false;
+    return applyFrame(io, alloc, storage, settings, &patch);
+}
+
+fn applyFrame(io: std.Io, alloc: Allocator, storage: *Storage, settings: command.AnimationFrameLoading, patch: *const image.Image) !command.Response {
+    const img = try find(storage, settings.transmission.image_id, settings.transmission.image_number);
+    try checkRect(img.width, img.height, settings.x, settings.y, patch.width, patch.height);
+    try prepare(alloc, storage, img);
+    const edit = if (settings.edit_frame != 0) try frameIndex(img, settings.edit_frame) else null;
+    const base = if (edit) |index| index else if (settings.create_frame != 0) try frameIndex(img, settings.create_frame) else null;
+    const frame_bytes = @as(usize, img.width) * img.height * 4;
+    if (edit == null and (frame_bytes > storage.total_limit -| storage.total_bytes or img.frames.items.len >= 4096)) return error.StorageFull;
+    var frame: image.Image.Frame = .{
+        .data = try alloc.alloc(u8, frame_bytes),
+        .gap_ms = if (settings.gap_ms == 0) (if (edit) |index| img.frames.items[index].gap_ms else 40) else @intCast(@max(0, settings.gap_ms)),
+        .usage = patch.usage,
+    };
+    errdefer alloc.free(frame.data);
+    if (base) |index| {
+        @memcpy(frame.data, img.frames.items[index].data);
+        frame.usage.transient = frame.usage.transient or img.frames.items[index].usage.transient;
+    } else {
+        const bg = settings.background;
+        for (0..frame_bytes / 4) |i| @memcpy(frame.data[i * 4 ..][0..4], &[_]u8{ bg.r, bg.g, bg.b, bg.a });
+    }
+    composePixels(frame.data, patch.data, img.width, patch.width, settings.x, settings.y, 0, 0, patch.width, patch.height, settings.composition_mode == .overwrite, if (patch.format == .rgb) 3 else 4);
+    if (edit) |index| {
+        alloc.free(img.frames.items[index].data);
+        img.frames.items[index] = frame;
+        if (index == img.current_frame) {
+            img.selectFrame(index);
+            changed(io, storage, img);
+        }
+    } else {
+        try img.frames.append(alloc, frame);
+        storage.total_bytes += frame_bytes;
+        storage.markMutated(io);
+    }
+    return .{ .id = img.id, .image_number = settings.transmission.image_number };
+}
+
+pub fn control(io: std.Io, alloc: Allocator, terminal: *Terminal, settings: command.AnimationControl) !command.Response {
+    const storage = &terminal.screens.active.kitty_images;
+    const img = try find(storage, settings.image_id, settings.image_number);
+    try prepare(alloc, storage, img);
+    const target = if (settings.current_frame != 0) try frameIndex(img, settings.current_frame) else null;
+    const gap_target = if (settings.frame != 0) try frameIndex(img, settings.frame) else img.current_frame;
+    if (settings.gap_ms != 0) {
+        img.frames.items[gap_target].gap_ms = @intCast(@max(0, settings.gap_ms));
+        if (gap_target == img.current_frame) img.next_frame_ms = null;
+    }
+    if (settings.loops != 0) img.loops = settings.loops - 1;
+    if (target) |index| {
+        img.selectFrame(index);
+        img.next_frame_ms = null;
+        changed(io, storage, img);
+    }
+    if (settings.action != .invalid) {
+        img.animation = settings.action;
+        img.next_frame_ms = null;
+        if (settings.action == .stop) img.completed_loops = 0;
+    }
+    _ = tickImage(io, alloc, storage, img, storage.now_ms);
+    return .{ .id = img.id, .image_number = settings.image_number };
+}
+
+pub fn compose(io: std.Io, alloc: Allocator, terminal: *Terminal, settings: command.AnimationFrameComposition) !command.Response {
+    const storage = &terminal.screens.active.kitty_images;
+    const img = try find(storage, settings.image_id, settings.image_number);
+    try prepare(alloc, storage, img);
+    const src = try frameIndex(img, settings.edit_frame);
+    const dst = try frameIndex(img, settings.frame);
+    const width = if (settings.width == 0) img.width else settings.width;
+    const height = if (settings.height == 0) img.height else settings.height;
+    try checkRect(img.width, img.height, settings.x, settings.y, width, height);
+    try checkRect(img.width, img.height, settings.left_edge, settings.top_edge, width, height);
+    if (src == dst and settings.x < settings.left_edge + width and settings.left_edge < settings.x + width and settings.y < settings.top_edge + height and settings.top_edge < settings.y + height) return error.InvalidData;
+    composePixels(img.frames.items[dst].data, img.frames.items[src].data, img.width, img.width, settings.left_edge, settings.top_edge, settings.x, settings.y, width, height, settings.composition_mode == .overwrite, 4);
+    img.frames.items[dst].usage.transient = img.frames.items[dst].usage.transient or img.frames.items[src].usage.transient;
+    if (dst == img.current_frame) {
+        img.selectFrame(dst);
+        changed(io, storage, img);
+    }
+    return .{ .id = img.id, .image_number = settings.image_number };
+}
+
+fn tickImage(io: std.Io, alloc: Allocator, storage: *Storage, img: *image.Image, now: u64) bool {
+    if (img.animation == .stop or img.frames.items.len == 0) return false;
+    if (img.next_frame_ms == null) img.next_frame_ms = now +| img.frames.items[img.current_frame].gap_ms;
+    var advanced = false;
+    // Bound catch-up work, including an animation containing only gapless frames.
+    var steps: usize = 0;
+    while (now >= img.next_frame_ms.?) : (steps += 1) {
+        if (steps >= img.frames.items.len * 2) {
+            img.next_frame_ms = now +| @max(1, img.frames.items[img.current_frame].gap_ms);
+            break;
+        }
+        var next = img.current_frame + 1;
+        if (next == img.frames.items.len) {
+            if (img.source) |source| {
+                const result = source.next(alloc, source.context) catch {
+                    storage.total_bytes -= source.retained_bytes;
+                    source.deinit(alloc);
+                    img.source = null;
+                    img.animation = .stop;
+                    img.next_frame_ms = null;
+                    break;
+                };
+                switch (result) {
+                    .pending => break,
+                    .done => {
+                        storage.total_bytes -= source.retained_bytes;
+                        source.deinit(alloc);
+                        img.source = null;
+                        if (img.frames.items.len == 1) {
+                            img.animation = .stop;
+                            img.next_frame_ms = null;
+                            break;
+                        }
+                    },
+                    .frame => |frame| {
+                        if (frame.data.len > storage.total_limit -| storage.total_bytes or img.frames.items.len >= 4096) {
+                            alloc.free(frame.data);
+                            storage.total_bytes -= source.retained_bytes;
+                            source.deinit(alloc);
+                            img.source = null;
+                            img.animation = .stop;
+                            img.next_frame_ms = null;
+                            break;
+                        }
+                        img.frames.append(alloc, frame) catch {
+                            alloc.free(frame.data);
+                            storage.total_bytes -= source.retained_bytes;
+                            source.deinit(alloc);
+                            img.source = null;
+                            img.animation = .stop;
+                            img.next_frame_ms = null;
+                            break;
+                        };
+                        storage.total_bytes += frame.data.len;
+                    },
+                }
+            }
+        }
+        if (next == img.frames.items.len) {
+            if (img.animation == .run_wait) break;
+            img.completed_loops +|= 1;
+            if (img.loops != 0 and img.completed_loops >= img.loops) {
+                img.animation = .stop;
+                img.next_frame_ms = null;
+                break;
+            }
+            next = 0;
+        }
+        img.selectFrame(next);
+        img.next_frame_ms = img.next_frame_ms.? +| img.frames.items[next].gap_ms;
+        advanced = true;
+    }
+    if (advanced) changed(io, storage, img);
+    return advanced;
+}
+
+pub fn tick(io: std.Io, alloc: Allocator, storage: *Storage, now: u64) bool {
+    storage.now_ms = @max(storage.now_ms, now);
+    var advanced = false;
+    var iter = storage.images.valueIterator();
+    while (iter.next()) |img| advanced = tickImage(io, alloc, storage, img, storage.now_ms) or advanced;
+    return advanced;
+}
+
+test "deferred animation accounts for frames and releases its source" {
+    const testing = std.testing;
+    const Source = @import("../sys.zig").Animation.Source;
+    const Context = struct {
+        polls: usize = 0,
+        frees: usize = 0,
+        fn next(alloc: Allocator, raw: *anyopaque) @import("../sys.zig").DecodeError!Source.Poll {
+            const self: *@This() = @ptrCast(@alignCast(raw));
+            self.polls += 1;
+            return switch (self.polls) {
+                1 => .pending,
+                2 => .{ .frame = .{ .data = try alloc.dupe(u8, &.{ 0, 0, 255, 255 }), .gap_ms = 10 } },
+                else => .done,
+            };
+        }
+        fn destroy(_: Allocator, raw: *anyopaque) void {
+            const self: *@This() = @ptrCast(@alignCast(raw));
+            self.frees += 1;
+        }
+    };
+    var context: Context = .{};
+    var img: image.Image = .{ .width = 1, .height = 1, .format = .rgba, .animation = .run, .next_frame_ms = 10 };
+    defer img.deinit(testing.allocator);
+    try img.frames.append(testing.allocator, .{ .data = try testing.allocator.dupe(u8, &.{ 255, 0, 0, 255 }), .gap_ms = 10 });
+    img.selectFrame(0);
+    img.source = .{ .context = &context, .retained_bytes = 8, .next = Context.next, .destroy = Context.destroy };
+    var storage: Storage = .{ .total_limit = 64, .total_bytes = img.byteSize() };
+    try testing.expect(!tickImage(testing.io, testing.allocator, &storage, &img, 10));
+    try testing.expectEqual(@as(usize, 12), storage.total_bytes);
+    try testing.expect(tickImage(testing.io, testing.allocator, &storage, &img, 10));
+    try testing.expectEqual(@as(usize, 16), storage.total_bytes);
+    try testing.expectEqual(@as(usize, 1), img.current_frame);
+    try testing.expect(tickImage(testing.io, testing.allocator, &storage, &img, 20));
+    try testing.expectEqual(@as(usize, 8), storage.total_bytes);
+    try testing.expectEqual(@as(usize, 1), context.frees);
+    try testing.expect(img.source == null);
+}
+
+test "deferred animation with one frame stops after decoder completion" {
+    const testing = std.testing;
+    const Source = @import("../sys.zig").Animation.Source;
+    const Context = struct {
+        fn next(_: Allocator, _: *anyopaque) @import("../sys.zig").DecodeError!Source.Poll {
+            return .done;
+        }
+        fn destroy(_: Allocator, _: *anyopaque) void {}
+    };
+    var context: u8 = 0;
+    var img: image.Image = .{ .width = 1, .height = 1, .format = .rgba, .animation = .run, .next_frame_ms = 10 };
+    defer img.deinit(testing.allocator);
+    try img.frames.append(testing.allocator, .{ .data = try testing.allocator.dupe(u8, &.{ 255, 0, 0, 255 }), .gap_ms = 10 });
+    img.selectFrame(0);
+    img.source = .{ .context = &context, .retained_bytes = 8, .next = Context.next, .destroy = Context.destroy };
+    var storage: Storage = .{ .total_limit = 64, .total_bytes = img.byteSize() };
+    try testing.expect(!tickImage(testing.io, testing.allocator, &storage, &img, 10));
+    try testing.expect(!tickImage(testing.io, testing.allocator, &storage, &img, 1000));
+    try testing.expectEqual(@as(usize, 4), storage.total_bytes);
+    try testing.expect(img.animation == .stop);
+}
