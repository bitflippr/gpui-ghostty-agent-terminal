diff --git a/src/terminal/iterm_image.zig b/src/terminal/iterm_image.zig
new file mode 100644
--- /dev/null
+++ b/src/terminal/iterm_image.zig
@@ -0,0 +1,188 @@
+//! iTerm2 OSC 1337 inline images. Parsing and cursor/scrollback ownership stay
+//! in the terminal; the embedder supplies the image decoder through sys.
+const std = @import("std");
+const lib = @import("lib.zig");
+const Terminal = @import("Terminal.zig");
+const sys = @import("sys.zig");
+const graphics = @import("kitty/graphics_storage.zig");
+const options = @import("terminal_options");
+const max_encoded = 96 * 1024 * 1024;
+
+pub const Command = extern struct { kind: u32, data: lib.String };
+
+const Dimension = union(enum) {
+    auto,
+    cells: f64,
+    pixels: f64,
+    percent: f64,
+
+    fn parse(text: []const u8) !Dimension {
+        if (std.mem.eql(u8, text, "auto")) return .auto;
+        const px = std.mem.endsWith(u8, text, "px");
+        const percent = std.mem.endsWith(u8, text, "%");
+        const number = text[0 .. text.len - @as(usize, if (px) 2 else if (percent) 1 else 0)];
+        const value = try std.fmt.parseFloat(f64, number);
+        if (!std.math.isFinite(value) or value <= 0 or value > 1000000) return error.InvalidSize;
+        return if (px) .{ .pixels = value } else if (percent) .{ .percent = value } else .{ .cells = value };
+    }
+
+    fn resolve(self: Dimension, cell: u32, extent: u32) ?f64 {
+        return switch (self) {
+            .auto => null,
+            .pixels => |v| v,
+            .cells => |v| v * @as(f64, @floatFromInt(cell)),
+            .percent => |v| v * @as(f64, @floatFromInt(extent)) / 100,
+        };
+    }
+};
+
+pub const Transfer = struct {
+    data: std.ArrayList(u8) = .empty,
+    active: bool = false,
+    name: []const u8 = &.{},
+    inline_image: bool = false,
+    preserve_aspect: bool = true,
+    width: Dimension = .auto,
+    height: Dimension = .auto,
+
+    pub fn deinit(self: *Transfer, alloc: std.mem.Allocator) void {
+        self.data.deinit(alloc);
+        alloc.free(self.name);
+        self.* = .{};
+    }
+
+    fn metadata(self: *Transfer, alloc: std.mem.Allocator, text: []const u8) !void {
+        var fields = std.mem.splitScalar(u8, text, ';');
+        while (fields.next()) |field| {
+            const eq = std.mem.indexOfScalar(u8, field, '=') orelse continue;
+            const key = field[0..eq];
+            const value = field[eq + 1 ..];
+            if (std.mem.eql(u8, key, "name")) {
+                const decoder = std.base64.standard.Decoder;
+                const len = try decoder.calcSizeForSlice(value);
+                if (len > 4096) return error.InvalidName;
+                const name = try alloc.alloc(u8, len);
+                errdefer alloc.free(name);
+                try decoder.decode(name, value);
+                alloc.free(self.name);
+                self.name = name;
+            } else if (std.mem.eql(u8, key, "inline")) {
+                self.inline_image = std.mem.eql(u8, value, "1");
+            } else if (std.mem.eql(u8, key, "preserveAspectRatio")) {
+                self.preserve_aspect = !std.mem.eql(u8, value, "0");
+            } else if (std.mem.eql(u8, key, "width")) {
+                self.width = try .parse(value);
+            } else if (std.mem.eql(u8, key, "height")) {
+                self.height = try .parse(value);
+            }
+        }
+    }
+
+    fn append(self: *Transfer, alloc: std.mem.Allocator, data: []const u8) !void {
+        if (data.len > max_encoded -| self.data.items.len) return error.ImageTooLarge;
+        try self.data.appendSlice(alloc, data);
+    }
+
+    pub fn process(self: *Transfer, t: *Terminal, cmd: Command, handler: anytype) !void {
+        if (comptime !options.kitty_graphics) return;
+        const alloc = t.gpa();
+        const text = cmd.data.ptr[0..cmd.data.len];
+        switch (cmd.kind) {
+            0 => {
+                self.deinit(alloc);
+                defer self.deinit(alloc);
+                const colon = std.mem.indexOfScalar(u8, text, ':') orelse return error.InvalidData;
+                try self.metadata(alloc, text[0..colon]);
+                try self.append(alloc, text[colon + 1 ..]);
+                try self.finish(t, handler);
+            },
+            1 => {
+                self.deinit(alloc);
+                try self.metadata(alloc, text);
+                self.active = true;
+            },
+            2 => {
+                if (!self.active) return error.NoTransfer;
+                if (text.len > 1048576) return error.ImageTooLarge;
+                try self.append(alloc, text);
+            },
+            3 => {
+                defer self.deinit(alloc);
+                if (!self.active) return error.NoTransfer;
+                try self.finish(t, handler);
+            },
+            4 => {
+                if (sys.decode_image != null and t.screens.active.kitty_images.enabled()) {
+                    if (handler.effects.write_pty) |write| write(handler, "\x1b]1337;Capabilities=F\x1b\\");
+                }
+            },
+            else => return error.InvalidData,
+        }
+    }
+
+    fn finish(self: *Transfer, t: *Terminal, handler: anytype) !void {
+        const alloc = t.gpa();
+        const storage = &t.screens.active.kitty_images;
+        const base64 = std.base64.standard.Decoder;
+        const len = try base64.calcSizeForSlice(self.data.items);
+        if (len > 64 * 1024 * 1024) return error.ImageTooLarge;
+        const encoded = try alloc.alloc(u8, len);
+        defer alloc.free(encoded);
+        try base64.decode(encoded, self.data.items);
+        if (!self.inline_image) {
+            const callback = handler.effects.file_download orelse return;
+            callback(handler, self.name, encoded);
+            return;
+        }
+        if (!storage.enabled()) return;
+        const decoder = sys.decode_image orelse return error.UnsupportedFormat;
+        const decoded = try decoder(alloc, encoded);
+        var pixels_owned = true;
+        defer if (pixels_owned) decoded.deinit(alloc);
+        if (decoded.width == 0 or decoded.height == 0 or decoded.frames.len == 0 or @as(usize, decoded.width) * decoded.height * 4 > storage.total_limit / decoded.frames.len) return error.InvalidSize;
+        const cell_w = @max(1, t.width_px / t.cols);
+        const cell_h = @max(1, t.height_px / t.rows);
+        const requested_w = self.width.resolve(cell_w, t.width_px);
+        const requested_h = self.height.resolve(cell_h, t.height_px);
+        const natural_w: f64 = @floatFromInt(decoded.width);
+        const natural_h: f64 = @floatFromInt(decoded.height);
+        var width = requested_w orelse natural_w;
+        var height = requested_h orelse natural_h;
+        if (self.preserve_aspect) {
+            const scale = if (requested_w != null and requested_h != null)
+                @min(width / natural_w, height / natural_h)
+            else if (requested_w != null) width / natural_w else if (requested_h != null) height / natural_h else @min(1, @as(f64, @floatFromInt(t.width_px)) / natural_w);
+            width = natural_w * scale;
+            height = natural_h * scale;
+        }
+        if (width < 1 or height < 1 or width > 1000000 or height > 1000000) return error.InvalidSize;
+        const pixel_width: u32 = @intFromFloat(@round(width));
+        const pixel_height: u32 = @intFromFloat(@round(height));
+        while (storage.next_image_id == 0 or storage.imageById(storage.next_image_id) != null) storage.next_image_id +%= 1;
+        const id = storage.next_image_id;
+        storage.next_image_id +%= 1;
+        const pin = try t.screens.active.pages.trackPin(t.screens.active.cursor.page_pin.*);
+        var pin_owned = true;
+        defer if (pin_owned) t.screens.active.pages.untrackPin(pin);
+        try storage.addImage(t.io(), alloc, t.screens.active, .{
+            .id = id,
+            .implicit_id = true,
+            .width = decoded.width,
+            .height = decoded.height,
+            .format = .rgba,
+            .data = decoded.frames[0].data,
+            .frames = .{ .items = decoded.frames, .capacity = decoded.frames.len },
+            .source = decoded.source,
+            .animation = if (decoded.frames.len > 1 or decoded.source != null) .run else .stop,
+            .loops = decoded.loops,
+            .next_frame_ms = storage.now_ms +| decoded.frames[0].gap_ms,
+        });
+        pixels_owned = false;
+        errdefer storage.delete(t.io(), alloc, t, .{ .id = .{ .image_id = id, .placement_id = 0, .delete = true } });
+        try storage.addPlacement(t.io(), alloc, t.screens.active, id, 0, .{ .location = .{ .pin = pin }, .pixel_width = pixel_width, .pixel_height = pixel_height });
+        pin_owned = false;
+        const rows = (pixel_height + cell_h - 1) / cell_h;
+        for (0..rows) |_| try t.index();
+        t.carriageReturn();
+    }
+};
