<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_ConptyFullRoot>$([System.IO.Path]::GetFullPath('$(SolutionDir)'))</_ConptyFullRoot>
    <_ConptySourceRoot>$([System.Text.RegularExpressions.Regex]::Replace('$(_ConptyFullRoot)', '[\\/]+$', ''))</_ConptySourceRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>%(AdditionalOptions) &quot;/d1trimfile:$(_ConptySourceRoot)\\&quot;</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>%(AdditionalOptions) /PDBALTPATH:%_PDB%</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
