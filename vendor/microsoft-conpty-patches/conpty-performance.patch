+void ParserTracing::TraceOscString(const std::wstring_view& string)
+{
+    // Preserve the per-character diagnostic stream without paying its cost
+    // for every code unit when no listener is attached.
+    if (TraceLoggingProviderEnabled(g_hConsoleVirtTermParserEventTraceProvider, WINEVENT_LEVEL_VERBOSE, TIL_KEYWORD_TRACE))
+    {
+        for (const auto ch : string)
+        {
+            TraceCharInput(ch);
+            TraceOnEvent(L"OscString");
+            TraceOnAction(L"OscPut");
+        }
+    }
+}
