+void StateMachineTest::OscBulkMatchesScalar()
+{
+    struct OscRecordingEngine final : TestStateMachineEngine
+    {
+        std::vector<std::pair<size_t, std::wstring>> osc;
+        bool ActionPrint(const wchar_t ch) override
+        {
+            printed += ch;
+            return true;
+        }
+        bool ActionOscDispatch(const size_t parameter, const std::wstring_view value) override
+        {
+            osc.emplace_back(parameter, value);
+            return true;
+        }
+    };
+
+    for (const bool acceptC1 : { false, true })
+    {
+        auto scalarEngine = std::make_unique<OscRecordingEngine>();
+        auto bulkEngine = std::make_unique<OscRecordingEngine>();
+        auto& scalar = *scalarEngine;
+        auto& bulk = *bulkEngine;
+        StateMachine scalarMachine{ std::move(scalarEngine) };
+        StateMachine bulkMachine{ std::move(bulkEngine), false, false };
+        scalarMachine.SetParserMode(StateMachine::Mode::AcceptC1, acceptC1);
+        bulkMachine.SetParserMode(StateMachine::Mode::AcceptC1, acceptC1);
+
+        // Every UTF-16 code unit is placed between long printable runs. This
+        // covers CAN/SUB, BEL, ESC, DEL, C1, NUL, and unpaired surrogates.
+        for (uint32_t value = 0; value <= 0xffff; ++value)
+        {
+            scalar.ResetTestState();
+            bulk.ResetTestState();
+            scalar.osc.clear();
+            bulk.osc.clear();
+            scalarMachine.ResetState();
+            bulkMachine.ResetState();
+            std::wstring input = L"\x1b]1337;ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+            input += static_cast<wchar_t>(value);
+            input += L"abcdefghijklmnopqrstuvwxyz0123456789\a\x18";
+            for (const auto ch : input)
+            {
+                scalarMachine.ProcessCharacter(ch);
+            }
+            // Sweep split positions while also testing complete runs.
+            const size_t chunkSize = 1 + value % 97;
+            for (size_t offset = 0; offset < input.size(); offset += chunkSize)
+            {
+                bulkMachine.ProcessString(std::wstring_view{ input }.substr(offset, chunkSize));
+            }
+            if (scalar.printed != bulk.printed || scalar.executed != bulk.executed || scalar.osc != bulk.osc)
+            {
+                Log::Comment(String().Format(L"Differential OSC failure at U+%04X, AcceptC1=%d", value, acceptC1));
+                VERIFY_FAIL(L"Bulk OSC parsing differs from scalar parsing");
+                return;
+            }
+        }
+    }
+}
+
+void StateMachineTest::OscBulkPreservesPassthrough()
+{
+    for (const auto terminator : { std::wstring_view{ L"\a" }, std::wstring_view{ L"\x1b\\" } })
+    {
+        std::wstring input = L"\x1b]1337;FilePart=";
+        input.append(65536, L'A');
+        input += L"\x7f\x1f\x4e00";
+        input += terminator;
+        for (const size_t chunkSize : { 1u, 2u, 7u, 8u, 9u, 31u, 64u, 127u, 16384u, 65536u, 131072u })
+        {
+            auto enginePtr = std::make_unique<TestStateMachineEngine>();
+            auto& engine = *enginePtr;
+            StateMachine machine{ std::move(enginePtr) };
+            engine.pfnFlushToTerminal = std::bind(&StateMachine::FlushToTerminal, &machine);
+            for (size_t offset = 0; offset < input.size(); offset += chunkSize)
+            {
+                machine.ProcessString(std::wstring_view{ input }.substr(offset, chunkSize));
+            }
+            VERIFY_ARE_EQUAL(input, engine.passedThrough);
+        }
+    }
+}
