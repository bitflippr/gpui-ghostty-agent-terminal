+    class InlineWriter {
+      static constexpr usize CHUNK_SIZE = 65536;
+#ifdef _WIN32
+      HANDLE     m_output;
+      bool       m_wide = false;
+      Vec<WCHAR> m_widened;
+#endif
+
+     public:
+      InlineWriter() {
+#ifdef _WIN32
+        // Preserve ordering with cursor controls buffered in std::cout.
+        std::cout.flush();
+        m_output          = GetStdHandle(STD_OUTPUT_HANDLE);
+        DWORD consoleMode = 0;
+        m_wide            = GetConsoleMode(m_output, &consoleMode);
+        if (m_wide)
+          m_widened.resize(CHUNK_SIZE);
+#endif
+      }
+
+      auto write(StringView sequence) -> void {
+#ifdef _WIN32
+        usize offset = 0;
+        while (offset < sequence.size() && std::cout.good()) {
+          const DWORD count   = static_cast<DWORD>(std::min(CHUNK_SIZE, sequence.size() - offset));
+          DWORD       written = 0;
+          BOOL        ok;
+          if (m_wide) {
+            // Inline protocol headers and base64 data are all ASCII.
+            for (usize i = 0; i < count; ++i)
+              m_widened[i] = static_cast<unsigned char>(sequence[offset + i]);
+            ok = WriteConsoleW(m_output, m_widened.data(), count, &written, nullptr);
+          } else {
+            ok = WriteFile(m_output, sequence.data() + offset, count, &written, nullptr);
+          }
+          if (!ok || written == 0) {
+            std::cout.setstate(std::ios::badbit);
+            return;
+          }
+          offset += written;
+        }
+#else
+        std::cout << sequence;
+#endif
+      }
+
+      static constexpr auto chunkSize() -> usize {
+        return CHUNK_SIZE;
+      }
+    };
+
+    auto WriteInlineSequence(StringView sequence, Span<const u8> streamedBytes) -> void {
+      InlineWriter writer;
+      writer.write(sequence);
+      if (streamedBytes.empty())
+        return;
+      constexpr StringView partHeader = "\033]1337;FilePart=";
+      // Include framing in the write limit and split input on complete base64 triples.
+      constexpr usize payloadSize    = ((InlineWriter::chunkSize() - partHeader.size() - 1) / 4) * 4;
+      constexpr usize inputChunkSize = payloadSize / 4 * 3;
+      String          part;
+      part.reserve(payloadSize + partHeader.size() + 1);
+      for (usize offset = 0; offset < streamedBytes.size() && std::cout.good(); offset += inputChunkSize) {
+        const auto chunk = streamedBytes.subspan(offset, std::min(inputChunkSize, streamedBytes.size() - offset));
+        part.resize_and_overwrite(((chunk.size() + 2) / 3) * 4 + partHeader.size() + 1, [&](char* dest, usize size) {
+          std::memcpy(dest, partHeader.data(), partHeader.size());
+          Base64EncodeInto(chunk, dest + partHeader.size());
+          dest[size - 1] = '\a';
+          return size;
+        });
+        writer.write(part);
+      }
+      writer.write("\033]1337;FileEnd\a");
+    }
